# Copy to .env and supply private credentials locally; never commit .env.
OVH_AI_KEY=replace-with-OVH-AI-key
OPENCODE_API_TOKEN=generate-a-random-token-with-at-least-32-bytes
OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_MODEL=Qwen3-Coder-30B-A3B-Instruct
DEBUG_KEEP_USER_DATA=false
OPENCODE_TIMEOUT=5400
GIT_CLONE_TIMEOUT=120
GIT_PUSH_TIMEOUT=120
REPO_DIFF_MAX_CHARS=60000
