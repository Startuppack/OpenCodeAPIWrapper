# Clé API OVH AI (obligatoire)
OVH_AI_KEY=your_ovh_ai_key_here

# Endpoint OVH AI (OpenAI-compatible)
# Remplace par ton endpoint réel disponible dans la console OVH AI Endpoints
OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1

# Modèle à utiliser (disponible sur ton endpoint OVH)
OVH_MODEL=Qwen2.5-Coder-32B-Instruct

DEBUG_KEEP_USER_DATA="true"
# This variable is used to keep user data in the database for debugging purposes. It should be set to "false" in production.
OPENCODE_TIMEOUT=900
# Timeout for OpenCode execution in seconds.

GIT_CLONE_TIMEOUT=600
# Timeout for cloning repositories in seconds.

GIT_PUSH_TIMEOUT=600
# Timeout for pushing repository changes in seconds.

REPO_DIFF_MAX_CHARS=60000
# Maximum number of diff characters returned by /process-repo.
